# MongoDB connection string. Example for local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=student_planner

# Optional server settings
# PORT=5173

# Separate admin dashboard credentials (required to use /admin).
ADMIN_USERNAME=Admin1
# Generate with: node --input-type=module -e "import bcrypt from 'bcryptjs'; console.log(await bcrypt.hash('your-password', 12))"
ADMIN_PASSWORD_HASH=
